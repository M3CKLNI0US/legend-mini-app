# Vite: только переменные с префиксом VITE_ попадают в клиентский бандл.

# Юзернейм бота (без @) — реферальные ссылки
VITE_BOT_USERNAME=YourBotUsername

# Бэкенд API (если появится)
VITE_API_URL=https://api.your-domain.com

# POST JSON с полями записи; сервер сам шлёт Telegram (токен только на сервере)
VITE_ADMIN_NOTIFY_URL=

# --- Переменные для Vercel (серверные функции в /api), без префикса VITE_
# TELEGRAM_BOT_TOKEN=123:ABC...   (тот же бот, что открывает Mini App)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  (JSON одной строкой из Firebase Console → Service accounts)
# ADMIN_TELEGRAM_IDS=1100054796   (через запятую, кто может слать из админки)
# FIREBASE_DATABASE_URL=https://legendproject-5baa7-default-rtdb.firebaseio.com  (опционально)
